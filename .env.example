# Credenciales de email para notificaciones (opcional)
# Si EMAIL_ENABLED=false en docker-compose.yml, estos valores se ignoran.
# Para activar notificaciones: cambiar EMAIL_ENABLED a "true" y completar los campos.
#
# Instrucciones para Gmail:
#   1. Activar verificación en dos pasos en tu cuenta Google
#   2. Ir a Cuenta de Google > Seguridad > Contraseñas de aplicación
#   3. Generar una contraseña para "Correo" y pegarla en EMAIL_APP_PASSWORD
#
# Copiar este archivo a .env y completar los valores:
#   cp .env.example .env

EMAIL_FROM=tucuenta@gmail.com
EMAIL_TO=destino@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
